# Firebase client SDK config (todos VITE_* son públicos por diseño)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: App Check (Fase 1, ver docs/SCALABILITY_OPERATIONS)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Versionado (lo inyecta Vite desde package.json; setear sólo para overrides locales)
VITE_APP_VERSION=
VITE_APP_CHANNEL=dev

# Backend
VITE_API_BASE_URL=http://localhost:4000
