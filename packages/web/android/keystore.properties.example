# Copy to keystore.properties (gitignored) and fill values.
# Generate a keystore once:
#   keytool -genkey -v -keystore release.keystore -alias dailytracker \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to packages/web/android/

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=dailytracker
keyPassword=CHANGE_ME
