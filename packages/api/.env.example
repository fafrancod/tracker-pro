# Servidor
PORT=4000
NODE_ENV=development
APP_CHANNEL=dev
BUILD_ID=

# Supabase (API usa service role — NUNCA en el frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3005

# Worker (jobs + notificaciones email embebidas)
RUN_EMBEDDED_WORKER=true
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY_MS=2000
JOB_RETRY_MAX_DELAY_MS=120000
JOB_RUNNING_TIMEOUT_MS=300000
JOB_SCAN_LIMIT=20
NOTIFICATIONS_INTERVAL_MS=60000

# Resend (recordatorios por correo). Sin key → envíos skipped en dev.
# Guía: docs/AUTH_AND_EMAIL.md · roadmap_mail.md
RESEND_API_KEY=
EMAIL_FROM=Daily Tracker <onboarding@resend.dev>
APP_NAME=Daily Tracker
APP_PUBLIC_URL=http://localhost:3005

# Cron externo opcional para POST /api/notifications/dispatch
CRON_SECRET=