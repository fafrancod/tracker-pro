# Servidor
PORT=4000
NODE_ENV=development
APP_CHANNEL=dev
BUILD_ID=

# Firebase Admin SDK — usar UNA de estas dos formas:
# (A) Service account inline (no commitear)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# (B) Application Default Credentials (preferido en GCP):
# Setear GOOGLE_APPLICATION_CREDENTIALS apuntando a un JSON, dejar las tres de arriba vacias.

# CORS
ALLOWED_ORIGINS=http://localhost:3002

# App Check
ENFORCE_APP_CHECK=false

# Worker
RUN_EMBEDDED_WORKER=true
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY_MS=2000
JOB_RETRY_MAX_DELAY_MS=120000
JOB_RUNNING_TIMEOUT_MS=300000
JOB_SCAN_LIMIT=20

# Presupuestos (documentacion; las alertas se configuran en la consola del proveedor)
FIREBASE_MONTHLY_BUDGET_USD=
RESEND_MONTHLY_BUDGET_USD=
ALERT_EMAIL=
