{
  "name": "daily-tracker",
  "version": "2.40.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:api": "npm run dev --workspace=packages/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=packages/api",
    "build:web": "npm run build --workspace=packages/web",
    "build:prod": "npm run build:web && npm run build:api",
    "start:api": "node packages/api/dist/server.cjs",
    "build:android": "npm run build:android --workspace=packages/web",
    "android:open": "npm run cap:android --workspace=packages/web",
    "android:sync": "npm run build:android",
    "android:build:debug": "npm run android:sync && node scripts/run-android-gradle.mjs assembleDebug",
    "android:copy-apk": "node scripts/copy-android-apk.mjs",
    "android:package:debug": "npm run android:build:debug && npm run android:copy-apk",
    "android:build:release": "npm run android:sync && node scripts/run-android-gradle.mjs bundleRelease",
    "android:copy-aab": "node scripts/copy-android-aab.mjs",
    "android:package:release": "npm run android:build:release && npm run android:copy-aab",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "version:set": "node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
