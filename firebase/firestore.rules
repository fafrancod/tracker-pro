rules_version = '2';

// Daily Tracker Firestore rules — bloqueo por defecto.
//
// Principios:
// - Owner-only reads en datos del usuario.
// - Escrituras sensibles (tasks, projects, usage, jobs, analytics) son
//   backend-only: el Admin SDK bypassea estas rules, asi que `allow write: if false`
//   no afecta al backend.
// - El cliente puede crear y editar su perfil con limitaciones (no puede tocar
//   `plan` ni `createdAt`).
// - Colecciones globales (errorLogs, sitePresence, jobQueue, webhookEvents)
//   son backend-only.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Devuelve los campos cambiados entre resource.data y request.resource.data.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Usuario y subcolecciones -----------------------------------------

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // profile/data — el cliente puede crear su perfil con plan=free y
      // actualizar solo `name` y `settings`. El `plan` solo cambia desde
      // backend (Admin SDK).
      match /profile/{doc} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.plan == 'free'
          && request.resource.data.email is string
          && request.resource.data.name is string;

        allow update: if isOwner(uid)
          && changedKeys().hasOnly(['name', 'settings'])
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if false;
      }

      // Tasks, projects, analytics, usage, jobs: lectura para el owner,
      // escritura solo desde backend.
      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /weeks/{weekId}/days/{dayId}/tasks/{taskId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /analytics/{weekId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /usage/{period} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /usageEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /jobs/{jobId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // --- Globales ----------------------------------------------------------

    // Logs de error: solo backend escribe; admin puede leer (cuando se cree
    // un panel admin web). El owner puede leer sus propios fallos por uid.
    match /errorLogs/{logId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Presencia: cada user escribe su propio doc (lectura: admin).
    match /sitePresence/{uid} {
      allow read: if isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Uso por seccion (agregado global): solo admin lee, solo backend escribe.
    match /siteSectionUsage/{period}/sections/{sectionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Queue de jobs y eventos de webhook: backend-only.
    match /jobQueue/{jobId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventKey} {
      allow read, write: if false;
    }

    // Catch-all: bloqueo por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
